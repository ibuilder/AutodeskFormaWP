{
	"name": "forma-to-wordpress-backend",
	"version": "1.0.0",
	"description": "Publishing backend that owns Autodesk Platform Services credentials and pushes signed Forma content into WordPress.",
	"license": "GPL-2.0-or-later",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.6"
	},
	"main": "dist/index.js",
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"start": "node dist/index.js",
		"dev": "node --watch --experimental-strip-types src/index.ts",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "npm run build && node --test \"test/**/*.test.ts\""
	},
	"dependencies": {
		"dotenv": "^16.4.5",
		"express": "^4.21.2",
		"zod": "^3.24.1"
	},
	"devDependencies": {
		"@types/express": "^4.17.21",
		"@types/node": "^22.10.5",
		"typescript": "^5.7.3"
	}
}
