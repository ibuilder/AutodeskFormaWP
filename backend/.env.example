# Copy to .env and fill in. Never commit the completed file.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATA_DIR=./data

# 32 bytes, hex encoded. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Autodesk Platform Services application credentials.
APS_CLIENT_ID=
APS_CLIENT_SECRET=
APS_CALLBACK_URL=http://localhost:3000/auth/callback
APS_BASE_URL=https://developer.api.autodesk.com
APS_SCOPES=data:read account:read

# WordPress receiver. WORDPRESS_KEY_ID and WORDPRESS_SECRET come from
# Forma -> Connections in the WordPress admin.
WORDPRESS_URL=https://example.com
WORDPRESS_REST_PREFIX=/wp-json
WORDPRESS_KEY_ID=
WORDPRESS_SECRET=

# Shared secret the Forma extension sends as the x-api-key header.
# Generate with: openssl rand -hex 24
EXTENSION_API_KEY=

JOB_MAX_ATTEMPTS=5
JOB_BASE_DELAY_MS=1000
HTTP_TIMEOUT_MS=30000
