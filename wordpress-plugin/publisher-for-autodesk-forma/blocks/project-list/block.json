{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "forma-publisher/project-list",
	"version": "1.2.1",
	"title": "Forma Project List",
	"category": "publisher-for-autodesk-forma",
	"icon": "grid-view",
	"description": "Displays a grid of projects published from Autodesk Forma.",
	"keywords": [ "forma", "autodesk", "projects" ],
	"textdomain": "publisher-for-autodesk-forma",
	"attributes": {
		"limit": { "type": "number", "default": 10 },
		"columns": { "type": "number", "default": 3 },
		"orderby": { "type": "string", "default": "date" },
		"order": { "type": "string", "default": "DESC" },
		"tag": { "type": "string", "default": "" },
		"status": { "type": "string", "default": "" },
		"showExcerpt": { "type": "boolean", "default": true },
		"showThumbnail": { "type": "boolean", "default": true },
		"showMetrics": { "type": "boolean", "default": false }
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"spacing": { "margin": true, "padding": true }
	},
	"editorScript": "file:./index.js",
	"render": "file:./render.php"
}
